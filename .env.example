# Environment variables for KognitMed
# Copy this file to .env and fill in your values

# ── App ──────────────────────────────────────────
APP_NAME=KognitMed
DEBUG=true
API_V1_PREFIX=/api/v1

# ── Security ─────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# CORS — JSON-encoded list of allowed origins (no wildcards in prod)
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# ── LLM Providers ────────────────────────────────
# Select provider: "openai" | "gemini"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── MongoDB Database ─────────────────────────────
# MongoDB is intentionally disabled for now.
# MONGO_HOST=localhost
# MONGO_PORT=27017
# MONGO_USER=admin
# MONGO_PASSWORD=securepassword123
# MONGO_DB=kognitmed

# ── ChromaDB Vector Store ────────────────────────
# Directorio local donde Chroma persiste los datos (modo archivo, sin servidor)
CHROMA_PERSIST_PATH=.chroma
